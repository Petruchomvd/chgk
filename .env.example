# === LLM providers ===

# === Local data ===

# SQLite databases. Relative paths are resolved from the project root and are
# intended only for local development or checking a downloaded backup.
# On the server, both live databases must use absolute paths outside the Git checkout:
# CHGK_DB_PATH=/var/lib/chgk/chgk_analysis.db
# CHGK_TRAINING_DB_PATH=/var/lib/chgk/training.db
CHGK_DB_PATH=chgk_analysis.db
CHGK_TRAINING_DB_PATH=training.db

# Groq
GROQ_API_KEY=gsk_your_key_here

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini
GOOGLE_API_KEY=your-key-here

# === Telegram training bot ===

# The training bot uses only this token.
CHGK_BOT_TOKEN=your-training-bot-token

# Comma-separated Telegram user ids allowed to use the bot in private chat.
# Example: CHGK_BOT_ALLOWED_TG_IDS=477617262,123456789,987654321
CHGK_BOT_ALLOWED_TG_IDS=

# Optional legacy owner id:
# - included into the allowlist automatically
# - used to attach old single-user training.db progress during migration
CHGK_BOT_OWNER_TG_ID=

# === Telegram classifier/notifier bot (optional) ===
CHGK_TG_BOT_TOKEN=your-notifier-bot-token
CHGK_TG_CHAT_ID=your-chat-id

# === Telegram digests / posting scripts (optional) ===
TG_DIGEST_BOT_TOKEN=your-digest-bot-token
TG_DIGEST_CHAT_ID=your-digest-chat-id
